# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kidorly?schema=public"

# Admin Auth
ADMIN_EMAIL="admin@kidorly.com"
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-at-least-32-random-characters"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
