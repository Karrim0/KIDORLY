generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id                 String       @id @default(cuid())
  slug               String       @unique
  nameAr             String       @map("name_ar")
  nameEn             String       @map("name_en")
  nameDe             String       @map("name_de")
  shortDescAr        String?      @map("short_desc_ar")
  shortDescEn        String?      @map("short_desc_en")
  shortDescDe        String?      @map("short_desc_de")
  descriptionAr      String?      @map("description_ar") @db.Text
  descriptionEn      String?      @map("description_en") @db.Text
  descriptionDe      String?      @map("description_de") @db.Text

  price              Float
  compareAtPrice     Float?       @map("compare_at_price")
  discountPercentage Float?       @map("discount_percentage")
  saleEndsAt         DateTime?    @map("sale_ends_at")

  availability       Availability @default(AVAILABLE)
  featured           Boolean      @default(false)

  images             String[]
  colors             String[]
  sizes              String[]

  seoTitleAr         String?      @map("seo_title_ar")
  seoTitleEn         String?      @map("seo_title_en")
  seoTitleDe         String?      @map("seo_title_de")
  seoDescAr          String?      @map("seo_desc_ar")
  seoDescEn          String?      @map("seo_desc_en")
  seoDescDe          String?      @map("seo_desc_de")

  categoryId         String?      @map("category_id")
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  brandId            String?      @map("brand_id")
  brand              Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)

  collections        ProductCollection[]
  tags               ProductTag[]
  ageGroups          ProductAgeGroup[]

  orderItems         OrderItem[]

  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([brandId])
  @@index([featured])
  @@index([availability])
  @@index([saleEndsAt])
  @@map("products")
}

model Brand {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String    @map("name_en")
  nameAr        String    @map("name_ar")
  nameDe        String    @map("name_de")
  descriptionEn String?   @map("description_en") @db.Text
  descriptionAr String?   @map("description_ar") @db.Text
  descriptionDe String?   @map("description_de") @db.Text
  logo          String?
  banner        String?
  featured      Boolean   @default(false)

  products      Product[]

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([slug])
  @@index([featured])
  @@map("brands")
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id                 String     @id @default(cuid())
  slug               String     @unique

  nameAr             String     @map("name_ar")
  nameEn             String     @map("name_en")
  nameDe             String     @map("name_de")

  descriptionAr      String?    @map("description_ar")
  descriptionEn      String?    @map("description_en")
  descriptionDe      String?    @map("description_de")

  image              String?
  icon               String?
  banner             String?

  discountPercentage Float?     @map("discount_percentage")

  visible            Boolean    @default(true)
  featured           Boolean    @default(false)
  sortOrder          Int        @default(0) @map("sort_order")

  parentId           String?    @map("parent_id")
  parent             Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[] @relation("CategoryTree")

  relatedTo          Category[] @relation("RelatedCategories")
  relatedFrom        Category[] @relation("RelatedCategories")

  seoTitleAr         String?    @map("seo_title_ar")
  seoTitleEn         String?    @map("seo_title_en")
  seoTitleDe         String?    @map("seo_title_de")
  seoDescAr          String?    @map("seo_desc_ar")
  seoDescEn          String?    @map("seo_desc_en")
  seoDescDe          String?    @map("seo_desc_de")

  products           Product[]

  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([visible])
  @@index([featured])
  @@index([sortOrder])
  @@map("categories")
}

// ─── Collections / Tags / Age Groups ─────────────────────────────────────────

model Collection {
  id            String              @id @default(cuid())
  slug          String              @unique

  nameAr        String              @map("name_ar")
  nameEn        String              @map("name_en")
  nameDe        String              @map("name_de")

  descriptionAr String?             @map("description_ar") @db.Text
  descriptionEn String?             @map("description_en") @db.Text
  descriptionDe String?             @map("description_de") @db.Text

  image         String?
  banner        String?

  type          CollectionType      @default(MARKETING)
  visible       Boolean             @default(true)
  featured      Boolean             @default(false)
  sortOrder     Int                 @default(0) @map("sort_order")

  products      ProductCollection[]

  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([visible])
  @@index([featured])
  @@index([sortOrder])
  @@map("collections")
}

model Tag {
  id        String       @id @default(cuid())
  slug      String       @unique

  nameAr    String       @map("name_ar")
  nameEn    String       @map("name_en")
  nameDe    String       @map("name_de")

  visible   Boolean      @default(true)
  featured  Boolean      @default(false)
  sortOrder Int          @default(0) @map("sort_order")

  products  ProductTag[]

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@index([visible])
  @@index([featured])
  @@index([sortOrder])
  @@map("tags")
}

model AgeGroup {
  id           String            @id @default(cuid())
  slug         String            @unique

  nameAr       String            @map("name_ar")
  nameEn       String            @map("name_en")
  nameDe       String            @map("name_de")

  minAgeMonths Int?              @map("min_age_months")
  maxAgeMonths Int?              @map("max_age_months")

  visible      Boolean           @default(true)
  featured     Boolean           @default(false)
  sortOrder    Int               @default(0) @map("sort_order")

  products     ProductAgeGroup[]

  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([visible])
  @@index([featured])
  @@index([sortOrder])
  @@map("age_groups")
}

model ProductCollection {
  productId    String     @map("product_id")
  collectionId String     @map("collection_id")

  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  assignedAt   DateTime   @default(now()) @map("assigned_at")

  @@id([productId, collectionId])
  @@index([collectionId])
  @@map("product_collections")
}

model ProductTag {
  productId  String   @map("product_id")
  tagId      String   @map("tag_id")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model ProductAgeGroup {
  productId  String   @map("product_id")
  ageGroupId String   @map("age_group_id")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  ageGroup   AgeGroup @relation(fields: [ageGroupId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([productId, ageGroupId])
  @@index([ageGroupId])
  @@map("product_age_groups")
}

enum CollectionType {
  MARKETING
  SEASONAL
  SYSTEM
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique @map("order_number")
  customerName    String         @map("customer_name")
  whatsappNumber  String         @map("whatsapp_number")
  city            String
  governorate     String?
  deliveryType    DeliveryType   @map("delivery_type")
  address         String?        @db.Text
  hotelName       String?        @map("hotel_name")
  guestName       String?        @map("guest_name")
  roomNumber      String?        @map("room_number")
  notes           String?        @db.Text
  paymentMethod   PaymentMethod  @map("payment_method")
  paymentStatus   PaymentStatus  @default(UNPAID) @map("payment_status")
  deliveryStatus  DeliveryStatus @default(NOT_DELIVERED) @map("delivery_status")
  subtotal        Float
  shippingCost    Float          @map("shipping_cost")
  total           Float
  locale          String         @default("en")
  items           OrderItem[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String   @map("order_id")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?  @map("product_id")
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String   @map("product_name")
  price       Float
  quantity    Int
  color       String?
  size        String?
  image       String?

  @@map("order_items")
}

enum DeliveryType {
  HOME
  HOTEL
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  VODAFONE_CASH
  INSTAPAY
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum DeliveryStatus {
  NOT_DELIVERED
  DELIVERED
}

// ─── Site Settings ───────────────────────────────────────────────────────────

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

// ─── Homepage Sections ───────────────────────────────────────────────────────

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique @map("section_key")
  data       String   @db.Text
  sortOrder  Int      @default(0) @map("sort_order")
  visible    Boolean  @default(true)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("homepage_sections")
}

model Media {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @map("public_id")
  filename  String?
  folder    String   @default("kidorly")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("media")
}